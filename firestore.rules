rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ログインした人は読める。書き込みは「設定・目標」で閲覧専用に登録された人以外
    function isViewer() {
      let path = /databases/$(database)/documents/settings/main;
      return exists(path) && request.auth.token.email in get(path).data.get('viewers', []);
    }
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && !isViewer();
    }
  }
}
